# ---------------------------------------------------------------------------
# Environment template — copy to `.env.local` and fill in YOUR OWN values.
# NEVER commit real keys. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Firebase (client SDK — safe to expose, but still keep per-project)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ---------------------------------------------------------------------------
# Firebase Admin (SERVER ONLY — treat as a password)
# Create at: Firebase Console → Project settings → Service accounts → Generate key
# Paste the values from the downloaded JSON here; keep the JSON file OUT of the repo.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Comma-separated list of admin emails (server-side gate for /admin APIs)
ADMIN_EMAILS="you@example.com"

# Same list exposed to the browser for client-side admin UI checks
NEXT_PUBLIC_ADMIN_EMAILS="you@example.com"

# ---------------------------------------------------------------------------
# Cloudinary (product media)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---------------------------------------------------------------------------
# Payments (Polar sandbox)
# ---------------------------------------------------------------------------
POLAR_ACCESS_TOKEN="polar_oat_xxx"
POLAR_ORGANIZATION_ID="your-org-id"
POLAR_PRODUCT_ID="your-product-id"
POLAR_WEBHOOK_SECRET="whsec_xxx"

# ---------------------------------------------------------------------------
# Payments (Razorpay — recommended for India: UPI / cards / netbanking / COD)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"

# ---------------------------------------------------------------------------
# Optional integrations (blueprint phases 2–3)
# ---------------------------------------------------------------------------
SHIPROCKET_EMAIL="you@example.com"
SHIPROCKET_PASSWORD="xxx"
MSG91_AUTH_KEY="xxx"
SES_FROM_EMAIL="no-reply@example.com"
SENTRY_DSN="https://xxx.ingest.sentry.io/xxx"
