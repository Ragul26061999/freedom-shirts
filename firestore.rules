rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this list in sync with ADMIN_EMAILS in the server environment.
    // `request.auth.token.admin == true` supports custom-claim based admins.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'innovacentra@gmail.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Admin back-office ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Profiles ───────────────────────────────────────────────────────────
    // Public read is required because reviews are joined with profile names.
    // Never store sensitive PII (phone, GSTIN, bank) on this document.
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Catalog ────────────────────────────────────────────────────────────
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shipping_rates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    // ── Cart (authenticated, owner only) ───────────────────────────────────
    match /carts/{cartId} {
      allow read, update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
    }
    match /cart_items/{itemId} {
      function ownsParentCart() {
        return isSignedIn()
          && get(/databases/$(database)/documents/carts/$(request.resource.data.cart_id)).data.user_id == request.auth.uid;
      }
      function ownsExistingParentCart() {
        return isSignedIn()
          && get(/databases/$(database)/documents/carts/$(resource.data.cart_id)).data.user_id == request.auth.uid;
      }
      allow read: if ownsExistingParentCart();
      allow create: if ownsParentCart();
      allow update: if ownsExistingParentCart()
        && request.resource.data.cart_id == resource.data.cart_id;
      allow delete: if ownsExistingParentCart();
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    // Orders are created exclusively by the server (checkout action / webhook).
    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.user_id);
      allow create: if false;
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(resource.data.user_id) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['has_return', 'return_status', 'return_id', 'status', 'cancellation_reason', 'updated_at'])
      );
    }
    match /order_items/{itemId} {
      allow read: if isAdmin() || isOwner(
        get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data.user_id
      );
      allow write: if isAdmin();
    }
    match /order_status_history/{entryId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Returns ────────────────────────────────────────────────────────────
    match /returns/{returnId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if isAdmin() || isOwner(resource.data.user_id);
      allow update, delete: if isAdmin();
    }

    // ── Addresses (server-managed at checkout; users may manage their own) ──
    match /addresses/{addressId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.user_id);
      allow create: if isAdmin() || isOwner(request.resource.data.user_id);
    }

    // ── Platform tables ────────────────────────────────────────────────────
    match /admin_users/{document=**} {
      allow read, write: if isAdmin();
    }
    match /audit_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /notifications/{notificationId} {
      allow read: if isAdmin() || isOwner(resource.data.user_id);
      allow write: if isAdmin();
    }
  }
}
