rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is the store admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'innovacentra@gmail.com';
    }

    // Check if user is accessing their own data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Give admin full access to everything by default
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Profiles: Anyone can read (needed for reviews). Users can write their own. Admin can do everything.
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Reviews: Anyone can read. Authenticated users can create/update/delete their own.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Products & Categories: Anyone can read. Only admin can write.
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Carts: Anyone can create/read/update a cart (for guest shopping)
    match /carts/{cartId} {
      allow read, write: if true; 
    }
    
    // Cart Items collection
    match /cart_items/{itemId} {
      allow read, write: if true;
    }

    // Orders: Anyone can create (guest checkout). Users read their own. Admin does all.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if (request.auth != null && resource.data.user_id == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
